@page "/"
@using TongjiHpcRegistrar.Services
@model TongjiHpcRegistrar.Pages.IndexModel
@{
    ViewData["Title"] = "Tongji Hpc Registrar";
}
<!doctype html>
<html lang="zh">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    @await Html.PartialAsync("_Styles")
</head>
<body>
    <main>
        <h1>Tongji Hpc Registrar</h1>
        <p>
            当前用户：<strong>@Model.UserName</strong>
            <form method="post" action="/Account/Logout" style="display:inline">
                <button type="submit">退出登录</button>
            </form>
        </p>

        @if (Model.Error is not null)
        {
            <div class="error">@Model.Error</div>
        }
        @if (Model.Success is not null)
        {
            <div class="notice">@Model.Success</div>
        }

        <h2>添加公钥</h2>
        <form method="post" asp-page-handler="AddKey">
            @Html.AntiForgeryToken()
            <label for="key">SSH 公钥：</label>
            <textarea id="key" name="key" rows="4" placeholder="ssh-ed25519 AAAA..." required></textarea>
            <button type="submit">添加</button>
        </form>

        <h2>我的公钥（@Model.Keys.Count）</h2>
        @if (Model.Keys.Count == 0)
        {
            <p>你还没有添加任何公钥。</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>公钥</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var key in Model.Keys)
                    {
                        <tr>
                            <td><code>@key.Key</code></td>
                            <td>
                                <form method="post" asp-page-handler="RemoveKey" onsubmit="return confirm('确认删除该公钥？');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="key" value="@key.Key" />
                                    <button type="submit" class="danger">删除</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </main>
</body>
</html>
