@page "/administration"
@using YueYinqiu.HpcRegistrar.Services
@model YueYinqiu.HpcRegistrar.Pages.AdministrationModel
@{
    ViewData["Title"] = $"所有隔离空间（{Model.Title}）";
}
<!doctype html>
<html lang="zh">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    @await Html.PartialAsync("_Styles")
</head>
<body>
    <main>
        <h1>所有隔离空间（@Model.Title）</h1>
        <p><a href="/">管理我的空间</a></p>

        @if (Model.Error is not null)
        {
            <div class="error">@Model.Error</div>
        }
        @if (Model.Success is not null)
        {
            <div class="notice">@Model.Success</div>
        }

        <h2>全部空间（@Model.Spaces.Count）</h2>
        @if (Model.Spaces.Count == 0)
        {
            <p>暂无隔离空间。</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>名称</th>
                        <th>归属人</th>
                        <th>公钥指纹</th>
                        <th>联系方式</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var space in Model.Spaces)
                    {
                        <tr>
                            <td><code>@space.Name</code></td>
                            <td>@space.Owner</td>
                            <td><code>@space.Fingerprint</code></td>
                            <td>@space.Contact</td>
                            <td>
                                <form method="post" asp-page-handler="Delete" onsubmit="return confirm('确认删除该隔离空间？');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="name" value="@space.Name" />
                                    <button type="submit" class="danger">删除</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </main>
</body>
</html>
