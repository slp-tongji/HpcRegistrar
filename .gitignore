## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# dotnet
project.lock.json
project.fragment.lock.json
artifacts/

# Publish output
publish/
*.pubxml
*.publishsettings

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Rider
.idea/

# VS Code
.vscode/

# Environment
*.db
*.db-*
.env
.env.*

# direnv
.direnv/

# macOS
.DS_Store
